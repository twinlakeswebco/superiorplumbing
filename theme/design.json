      "kind": "nav",
      "description": "Desktop navigation with explicit current-page treatment.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><a href=\"#\" aria-current=\"page\">Home</a><a href=\"#\">Services</a><a href=\"#\">Our work</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:clamp(18px,2.1vw,32px);align-items:center;font-family:var(--font,Geist,Arial,sans-serif);}.ds-nav a{color:var(--navy,#0b2145);font-size:14px;font-weight:550;line-height:1.6;text-decoration:none;padding:10px 0;}.ds-nav a:hover,.ds-nav a[aria-current]{color:var(--red,#ba1527);}.ds-nav a[aria-current]{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:5px;}.ds-nav a:focus-visible{outline:3px solid var(--focus,#287cce);outline-offset:6px;}"
